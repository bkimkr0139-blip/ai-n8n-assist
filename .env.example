# ===== 이 파일을 .env 로 복사한 뒤 값을 채우세요 =====
#   cp .env.example .env

# --- 외부 공개 URL (Telegram webhook용, HTTPS 필수) ---
# 로컬 개발: ngrok/cloudflared 로 http://localhost:5678 를 터널링한 HTTPS URL.
#   예) ngrok http 5678  →  https://xxxx.ngrok-free.dev
# 클라우드: 공개 도메인. 예) https://n8n.example.com
# (비워두면 n8n은 뜨지만 Telegram 연동은 안 됨)
WEBHOOK_URL=https://YOUR-PUBLIC-HTTPS-URL
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Seoul

# --- n8n 자격증명 암호화 키 (반드시 한 번 생성 후 고정) ---
# 생성: openssl rand -hex 32   (또는 임의의 긴 무작위 문자열)
# 이 키가 바뀌면 저장된 자격증명을 복호화할 수 없게 됨.
N8N_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

# --- 음성 답장용 Telegram 봇 토큰 ---
# 음성 메시지에 음성(voice note)으로 답하는 'Send Voice' 노드가 Telegram sendVoice API를
# 직접 호출할 때 사용. BotFather에서 받은 봇 토큰과 동일. (n8n Telegram 자격증명과 별개로 필요)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# --- Postgres (PGVector RAG 저장소) ---
# n8n UI에서 Postgres 자격증명을 만들 때 host 는 컨테이너명 'postgres' 사용.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=n8n_rag
