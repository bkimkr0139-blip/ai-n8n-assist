    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chunks = [];\nfor (const it of items) {\n  const j = it.json || {};\n  let text = '';\n  if (j.document && typeof j.document.pageContent === 'string') text = j.document.pageContent;\n  else if (typeof j.pageContent === 'string') text = j.pageContent;\n  else if (typeof j.text === 'string') text = j.text;\n  if (text && text.trim()) chunks.push(text.trim());\n}\nconst context = chunks.length\n  ? chunks.map((c, i) => `[문서 ${i + 1}]\\n${c}`).join('\\n\\n')\n  : '(관련 등록 문서 없음)';\nconst prep = $('Prepare Input').first().json;\nconst userMessage = prep.query || '';\nconst chatId = prep.chatId;\nconst isVoice = prep.isVoice === true;\nreturn [{ json: { userMessage, context, chatId, isVoice } }];"
      },
