            { "id": "subject", "displayName": "subject", "type": "string", "canBeUsedToMatch": false, "required": false, "display": true, "defaultMatch": false },
            { "id": "body", "displayName": "body", "type": "string", "canBeUsedToMatch": false, "required": false, "display": true, "defaultMatch": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
