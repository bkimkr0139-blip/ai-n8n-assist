    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "당신은 BC Kim의 개인 비서입니다. 반드시 아래 JSON 형식으로만 응답하세요. JSON 외 다른 텍스트는 절대 출력하지 마세요.\n\n이메일 발송 요청이고 받는사람/제목/본문이 모두 명확하면:\n{\"action\":\"email\",\"to\":\"받는주소\",\"subject\":\"제목\",\"body\":\"본문\"}\n\n그 외 모든 경우(일반 대화, 이메일 정보 부족 등):\n{\"action\":\"chat\",\"reply\":\"사용자에게 보낼 한국어 답변\"}\n\n이메일 정보가 부족하면 action을 chat으로 하고 reply에 무엇이 필요한지 물어보세요. 대화 맥락을 활용하세요."
        }
      },
      "id": "ba0f4135-3f22-456b-ae77-f555536f81f8",
      "name": "AI Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [576, 560]
    },
    {
      "parameters": { "model": { "__rl": true, "mode": "id", "value": "gpt-4o-mini" }, "options": {} },
      "id": "ec88fca1-7f0c-491d-aa51-e04678fb6d1b",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [208, 816],
      "credentials": { "openAiApi": { "id": "", "name": "OpenAI" } }
    },
    {
      "parameters": { "sessionIdType": "customKey", "sessionKey": "={{ $(\"Telegram Trigger\").item.json.message.chat.id }}", "contextWindowLength": 10 },
      "id": "284fa92f-9be8-4ce2-b415-82e267393786",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [400, 832]
    },
    {
      "parameters": { "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}", "text": "={{ $json.reply }}", "additionalFields": {} },
      "id": "664502f0-57ff-4905-9fda-dc8467103da4",
      "name": "Reply: Chat",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1248, 816],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output ?? '').toString();\nlet parsed;\ntry {\n  let txt = raw.trim();\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(m ? m[0] : txt);\n} catch (e) {\n  parsed = { action: 'chat', reply: raw };\n}\nif (!parsed.action) parsed.action = 'chat';\nif (parsed.action === 'chat' && !parsed.reply) parsed.reply = raw;\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nreturn [{ json: { action: parsed.action, to: parsed.to || '', subject: parsed.subject || '', body: parsed.body || '', reply: parsed.reply || '', chatId } }];"
      },
      "id": "7f61781f-2e5c-44b7-8ef2-d88c6da5de4a",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [832, 560]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "email-check", "leftValue": "={{ $json.action }}", "rightValue": "email", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ea6e4257-3d2c-4f86-944a-8efb7618dcb8",
      "name": "Is Email?",
