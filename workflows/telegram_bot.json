      "name": "Prepare Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        320
      ],
      "parameters": {
        "jsCode": "const trig = $('Telegram Trigger').first().json;\nconst chatId = trig.message && trig.message.chat ? trig.message.chat.id : null;\nconst j = $input.first().json || {};\nlet query = '';\nlet isVoice = false;\nif (typeof j.text === 'string' && !j.message) {\n  query = j.text;\n  isVoice = true;\n} else {\n  query = (trig.message && trig.message.text) ? trig.message.text : '';\n  isVoice = false;\n}\nreturn [{ json: { query, isVoice, chatId } }];"
      }
    },
