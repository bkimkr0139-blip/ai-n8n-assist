    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output ?? '').toString();\nlet parsed;\ntry {\n  let txt = raw.trim();\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(m ? m[0] : txt);\n} catch (e) {\n  parsed = { action: 'chat', reply: raw };\n}\nif (!parsed.action) parsed.action = 'chat';\nif (parsed.action === 'chat' && !parsed.reply) parsed.reply = raw;\nconst bc = $('Build Context').first().json;\nconst chatId = bc.chatId;\nconst isVoice = bc.isVoice === true;\nreturn [{ json: { action: parsed.action, to: parsed.to || '', subject: parsed.subject || '', body: parsed.body || '', reply: parsed.reply || '', chatId, isVoice } }];"
      },
      "id": "7f61781f-2e5c-44b7-8ef2-d88c6da5de4a",
