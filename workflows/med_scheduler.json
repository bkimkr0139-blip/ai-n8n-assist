{
  "name": "med_scheduler",
  "nodes": [
    {
      "id": "wh",
      "name": "일정 수신(웹훅)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        -160
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "med-config",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "med-config"
    },
    {
      "id": "prep",
      "name": "쿼리 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -160
      ],
      "parameters": {
        "jsCode": "const inp=$input.first().json;\nconst body=(inp&&inp.body)?inp.body:inp;\nconst chatId=String((body&&body.chatId)||'').replace(/'/g,\"''\");\nconst schedule=Array.isArray(body&&body.schedule)?body.schedule:[];\nconst json=JSON.stringify(schedule).replace(/'/g,\"''\");\nconst query=\"INSERT INTO med_schedules (chat_id, schedule) VALUES ('\"+chatId+\"', '\"+json+\"'::jsonb) ON CONFLICT (chat_id) DO UPDATE SET schedule=EXCLUDED.schedule, updated_at=now()\";\nreturn [{ json:{ query, ok:true, chatId, count:schedule.length } }];"
      }
    },
    {
      "id": "save",
      "name": "일정 저장(DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        -160
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query }}"
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "pgvector RAG (n8n_rag)"
        }
      }
    },
    {
      "id": "tick",
      "name": "5분마다",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        140
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "read",
      "name": "일정 읽기(DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chat_id, schedule FROM med_schedules"
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "pgvector RAG (n8n_rag)"
        }
      }
    },
    {
      "id": "find",
      "name": "복용시간 확인",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        140
      ],
      "parameters": {
        "jsCode": "const rows=$input.all();\nconst now=new Date(Date.now()+9*3600*1000);\nconst hh=now.getUTCHours(), mm=now.getUTCMinutes();\nconst out=[];\nfor(const r of rows){ const j=r.json||{}; const chatId=j.chat_id; let s=j.schedule;\n  if(typeof s==='string'){ try{ s=JSON.parse(s); }catch(e){ s=[]; } }\n  if(!Array.isArray(s)) s=[];\n  for(const e of s){ if(!e||!e.time) continue; const p=String(e.time).split(':'); const eh=parseInt(p[0],10), em=parseInt(p[1],10);\n    if(eh===hh && em>=mm && em<mm+5){ out.push({ json:{ chatId, med:e.med||'', when:e.when||'', time:e.time } }); } } }\nreturn out;"
      }
    },
    {
      "id": "rem",
      "name": "복약 알림",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "=💊 약 드실 시간이에요. {{ $json.when }} {{ $json.med }} 드실 시간입니다. 통화로 안내받으시려면 아래를 눌러주세요:\nhttps://bkimkr0139-blip.github.io/ai-n8n-assist/realtime-voice/care.html?purpose=med",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "webhookId": "2a070c56-593e-4448-8ac4-f7bde93b659a",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "일정 수신(웹훅)": {
      "main": [
        [
          {
            "node": "쿼리 준비",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "쿼리 준비": {
      "main": [
        [
          {
            "node": "일정 저장(DB)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5분마다": {
      "main": [
        [
          {
            "node": "일정 읽기(DB)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "일정 읽기(DB)": {
      "main": [
        [
          {
            "node": "복용시간 확인",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "복용시간 확인": {
      "main": [
        [
          {
            "node": "복약 알림",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  }
}
