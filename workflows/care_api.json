    {
      "id": "sumbuild",
      "name": "요약프롬프트",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b=($input.first().json.body)||{};\nconst past=(b.past||'(없음)').toString();\nconst convo=(b.convo||'').toString();\nconst device_id=(b.device_id||'').toString();\nconst prompt='다음은 돌봄 도우미와 어르신의 통화 내용입니다. 다음 통화 때 참고할 \"어르신 메모\"를 한국어로 갱신해 주세요. 기존 메모와 이번 통화를 합쳐서, 어르신 호칭/성함, 건강상태와 통증, 기분, 가족/일상, 걱정거리, 약속한 것, 다음에 여쭤볼 것을 간결한 불릿으로 12줄 이내로 정리하세요. 메모만 출력하세요.\\n\\n[기존 메모]\\n'+past+'\\n\\n[이번 통화]\\n'+convo;\nreturn [{ json:{ prompt, device_id } }];"
      }
    },
    {
      "id": "chat",
      "name": "요약호출",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.3, messages: [ { role: 'user', content: $json.prompt } ] }) }}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI 2026-05"
        }
      }
    },
    {
      "id": "sumextract",
      "name": "요약추출",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json||{};\nconst memo=((d.choices&&d.choices[0]&&d.choices[0].message&&d.choices[0].message.content)||'').trim();\nlet dev=''; try{ dev=String($('요약프롬프트').first().json.device_id||''); }catch(e){}\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nconst query = dev ? (\"INSERT INTO care_profiles (device_id, memo, visits, updated_at) VALUES ('\"+esc(dev)+\"', '\"+esc(memo)+\"', 1, now()) ON CONFLICT (device_id) DO UPDATE SET memo=EXCLUDED.memo, visits=care_profiles.visits+1, updated_at=now()\") : \"SELECT 1 WHERE false\";\nreturn [{ json:{ memo, query, device_id:dev } }];"
      }
    },
    {
      "id": "sumsave",
      "name": "요약저장",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query }}"
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "pgvector RAG (n8n_rag)"
        }
      }
    },
    {
      "id": "sumout",
      "name": "요약응답",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "let memo=''; try{ memo=String($('요약추출').first().json.memo||''); }catch(e){}\nreturn [{ json:{ memo } }];"
      }
    },
    {
      "id": "profget",
      "name": "프로필조회요청",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        220
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "care-profile",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
