    {
      "id": "getbuild",
      "name": "조회빌드",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ],
      "parameters": {
        "jsCode": "const q=($input.first().json.query)||{};\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nconst id=esc(q.device_id||'');\nconst query=\"SELECT device_id,name,region,voice,env,speed,memo,visits FROM care_profiles WHERE device_id='\"+id+\"'\";\nreturn [{ json:{ query } }];"
      }
    },
    {
      "id": "profsel",
      "name": "프로필조회",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        220
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query }}"
      },
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "",
          "name": "pgvector RAG (n8n_rag)"
        }
      }
    },
    {
      "id": "getout",
      "name": "조회응답",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ],
      "parameters": {
        "jsCode": "const rows=$input.all();\nconst r=(rows.length&&rows[0].json)?rows[0].json:{};\nconst known=!!(r&&r.device_id);\nreturn [{ json:{ known, name:r.name||'', region:r.region||'', voice:r.voice||'', env:r.env||'', speed:r.speed||'', memo:r.memo||'', visits:r.visits||0 } }];"
      }
    },
    {
      "id": "profpost",
      "name": "프로필저장요청",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        440
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "care-profile-save",
