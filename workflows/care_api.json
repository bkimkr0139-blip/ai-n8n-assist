      "parameters": {
        "jsCode": "const b=($input.first().json.body)||{};\nconst PASS='CHANGE_ME_ADMIN_PASS';\nif(String(b.pass||'')!==PASS) return [{ json:{ query:\"SELECT 1 WHERE false\", ok:false, auth:false } }];\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nconst id=esc(b.device_id||'');\nlet st=String(b.status||'').trim(); if(['approved','blocked','pending'].indexOf(st)<0) st='blocked';\nconst reason = st==='blocked' ? esc(String(b.reason||'').slice(0,300)) : '';\nconst query = id ? (\"INSERT INTO care_profiles (device_id,status,block_reason,updated_at) VALUES ('\"+id+\"','\"+st+\"','\"+reason+\"',now()) ON CONFLICT (device_id) DO UPDATE SET status='\"+st+\"', block_reason='\"+reason+\"', updated_at=now()\") : \"SELECT 1 WHERE false\";\nreturn [{ json:{ query, ok:!!id, auth:true, status:st } }];"
