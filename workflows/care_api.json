      "name": "세션빌드",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        660
      ],
      "parameters": {
        "jsCode": "const b=($input.first().json.body)||{};\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nconst n=v=>{ const x=parseInt(v,10); return isNaN(x)?0:x; };\nconst id=esc(b.device_id||'');\nif(!id) return [{json:{query:\"SELECT 1 WHERE false\"}}];\nconst st=b.started_at?(\"'\"+esc(b.started_at)+\"'\"):'now()';\nconst en=b.ended_at?(\"'\"+esc(b.ended_at)+\"'\"):'now()';\nconst tr=esc(String(b.transcript||'').slice(0,8000));\nconst query=\"INSERT INTO care_sessions (device_id,started_at,ended_at,duration_sec,turns,input_tokens,output_tokens,total_tokens,transcript) VALUES ('\"+id+\"',\"+st+\",\"+en+\",\"+n(b.duration_sec)+\",\"+n(b.turns)+\",\"+n(b.input_tokens)+\",\"+n(b.output_tokens)+\",\"+n(b.total_tokens)+\",'\"+tr+\"')\";\nreturn [{json:{query}}];"
      }
    },
