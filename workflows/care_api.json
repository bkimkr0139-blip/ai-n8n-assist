      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        1540
      ],
      "parameters": {
        "jsCode": "const b=($input.first().json.body)||{};\nconst PASS='CHANGE_ME_ADMIN_PASS';\nif(String(b.pass||'')!==PASS) return [{ json:{ query:\"SELECT 1 WHERE false\", ok:false, auth:false, n:0 } }];\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nlet ids=Array.isArray(b.device_ids)?b.device_ids:[];\nids=ids.map(x=>esc(x)).filter(Boolean);\nif(!ids.length) return [{ json:{ query:\"SELECT 1 WHERE false\", ok:false, auth:true, n:0 } }];\nconst inlist=ids.map(x=>\"'\"+x+\"'\").join(',');\nconst query=\"DELETE FROM care_sessions WHERE device_id IN (\"+inlist+\"); DELETE FROM care_profiles WHERE device_id IN (\"+inlist+\")\";\nreturn [{ json:{ query, ok:true, auth:true, n:ids.length } }];"
      }
