        "jsCode": "const r=$input.first().json||{};\nconst provider=(r.provider||'openai').toString();\nconst model=(r.model||'gpt-4o-mini').toString();\nconst endpoint=(r.endpoint||'https://api.openai.com/v1/chat/completions').toString();\nlet prompt=''; try{ prompt=String($('요약프롬프트').first().json.prompt||''); }catch(e){}\nconst body={ model, temperature:0.3, messages:[{role:'user', content:prompt}] };\nreturn [{ json:{ url:endpoint, body:JSON.stringify(body), provider, model } }];"
      }
