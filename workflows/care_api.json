    {
      "id": "savebuild",
      "name": "저장빌드",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        440
      ],
      "parameters": {
        "jsCode": "const b=($input.first().json.body)||{};\nconst esc=s=>String(s==null?'':s).replace(/'/g,\"''\");\nconst id=esc(b.device_id||'');\nlet query;\nif(!id){ query=\"SELECT 1 WHERE false\"; }\nelse { query=\"INSERT INTO care_profiles (device_id,name,region,voice,env,speed,updated_at) VALUES ('\"+id+\"','\"+esc(b.name)+\"','\"+esc(b.region)+\"','\"+esc(b.voice)+\"','\"+esc(b.env)+\"','\"+esc(b.speed)+\"',now()) ON CONFLICT (device_id) DO UPDATE SET name=EXCLUDED.name, region=EXCLUDED.region, voice=EXCLUDED.voice, env=EXCLUDED.env, speed=EXCLUDED.speed, updated_at=now()\"; }\nreturn [{ json:{ query } }];"
      }
    },
